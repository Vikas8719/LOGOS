   "source": [
    "# CELL 2 — Dataset: exactly 5MB TinyStories\n",
    "TARGET_MB    = 5\n",
    "TARGET_BYTES = TARGET_MB * 1024 * 1024\n",
    "\n",
    "if os.path.exists(TRAIN_FILE) and os.path.getsize(TRAIN_FILE) >= TARGET_BYTES // 2:\n",
    "    sz = os.path.getsize(TRAIN_FILE) // 1024 // 1024\n",
    "    print(f'✅ dataset.txt already exists: {sz} MB — reusing')\n",
    "else:\n",
    "    print(f'Preparing {TARGET_MB}MB dataset...')\n",
    "    done = False\n",
    "\n",
    "    # 1. Local Kaggle input (.txt)\n",
    "    for f in glob.glob('/kaggle/input/**/*.txt', recursive=True):\n",
    "        if os.path.getsize(f) > 1024*1024:\n",
    "            print(f'Using local: {f}')\n",
    "            with open(f, 'r', errors='ignore') as fin, open(TRAIN_FILE, 'w') as fout:\n",
    "                fout.write(fin.read(TARGET_BYTES))\n",
    "            done = True; break\n",
    "\n",
    "    # 2. Local .jsonl\n",
    "    if not done:\n",
    "        for f in glob.glob('/kaggle/input/**/*.jsonl', recursive=True):\n",
    "            if os.path.getsize(f) > 1024*1024:\n",
    "                print(f'Using JSONL: {f}')\n",
    "                written = 0\n",
    "                with open(TRAIN_FILE, 'w') as fout:\n",
    "                    with open(f, 'r', errors='ignore') as fin:\n",
    "                        for line in fin:\n",
    "                            if written >= TARGET_BYTES: break\n",
    "                            try:\n",
    "                                obj = json.loads(line)\n",
    "                                t = obj.get('story', obj.get('text', obj.get('content','')))\n",
    "                                if t:\n",
    "                                    fout.write(t.strip() + '\\n\\n')\n",
    "                                    written += len(t)\n",
    "                            except: pass\n",
    "                done = True; break\n",
    "\n",
    "    # 3. Download from HuggingFace (5MB only — fast)\n",
    "    if not done:\n",
    "        print('Downloading 5MB from HuggingFace...')\n",
    "        tmp = '/kaggle/working/_ts_tmp.txt'\n",
    "        ret = subprocess.run([\n",
    "            'wget', '-q', '--timeout=60',\n",
    "            'https://huggingface.co/datasets/roneneldan/TinyStories/resolve/main/TinyStoriesV2-GPT4-train.txt',\n",
    "            '-O', tmp\n",
    "        ], capture_output=True)\n",
    "        if ret.returncode == 0 and os.path.exists(tmp):\n",
    "            with open(tmp,'r',errors='ignore') as fin, open(TRAIN_FILE,'w') as fout:\n",
    "                fout.write(fin.read(TARGET_BYTES))\n",
    "            os.remove(tmp)\n",
    "            done = True\n",
    "            print('✅ Downloaded')\n",
    "        else:\n",
    "            print(f'wget failed: {ret.stderr.decode()[:100]}')\n",
    "\n",
    "    # 4. Synthetic fallback (~1.5MB — still enough to see loss drop)\n",
    "    if not done:\n",
    "        print('Using synthetic fallback (~1.5MB)...')\n",
    "        stories = [\n",
    "            'Once upon a time there was a little girl named Lily. She loved to play in the garden with her dog Max. One day she found a beautiful butterfly and followed it deep into the forest.\\n\\n',\n",
    "            'Tom was a curious boy who loved reading books about science and nature every evening before bed. His favourite book was about the stars and planets in the solar system.\\n\\n',\n",
    "            'The sun rose slowly over the small village. Birds began to sing their morning songs. Anna woke up early and looked out her window at the golden fields.\\n\\n',\n",
    "            'Ben and his sister Sara found a tiny puppy near the old oak tree in the park. They took the puppy home and gave it food and water and named it Buddy.\\n\\n',\n",
    "            'The old wizard lived in a tall tower at the edge of town. He spent his days studying ancient maps and mixing colourful potions in his laboratory.\\n\\n',\n",
    "            'Emma wanted to bake a cake for her mother birthday. She measured the flour and sugar carefully and cracked the eggs into a big bowl. The cake smelled wonderful.\\n\\n',\n",
    "            'Jake loved to draw pictures of dragons and castles. He filled notebook after notebook with his colourful drawings and dreamed of becoming an artist one day.\\n\\n',\n",
    "            'Maya and her grandfather went fishing by the river every Saturday morning. They sat quietly and watched the water sparkle in the sunlight while they waited.\\n\\n',\n",
    "        ]\n",
    "        with open(TRAIN_FILE, 'w') as f:\n",
    "            written = 0\n",
    "            while written < TARGET_BYTES:\n",
    "                for s in stories:\n",
    "                    f.write(s); written += len(s)\n",
    "        print('✅ Synthetic dataset created')\n",
    "\n",
    "sz = os.path.getsize(TRAIN_FILE)\n",
    "print(f'\\n✅ Dataset: {sz//1024} KB  ({sz:,} bytes)')\n",
    "print('Preview:')\n",
    "print('-'*50)\n",
    "with open(TRAIN_FILE) as f: print(f.read(300))\n",
    "print('-'*50)"
   ]
